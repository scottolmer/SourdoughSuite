type InputMethod = "structured-form" | "free-text" | "import-url" | "upload-image";
type StatusType = 'pass' | 'warning' | 'error';
type SeverityType = 'high' | 'medium' | 'low';
type MetricType = 'critical' | 'warning' | 'suggestion';

interface ValidationIssue {
  severity: SeverityType;
  issue: string;
  impact: string;
  suggestion: string;
  fixable: boolean;
}

interface ParameterGaugeProps {
  label: string;
  value: number | null;
  status: StatusType;
  ideal: number;
  min: number;
  max: number;
  step?: number;
  unit?: string;
}

interface MetricCardProps {
  label: string;
  value: number;
  type: MetricType;
  icon: React.ReactNode;
}

interface IssueCardProps {
  issue: ValidationIssue;
  onFix: (issue: ValidationIssue) => void;
}

