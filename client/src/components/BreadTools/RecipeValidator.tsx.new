// Component for displaying parameter measurements
function ParameterGauge({ label, value, status, ideal, min, max, step = 1, unit = '%' }: ParameterGaugeProps) {
  // Status colors
  const statusColors: Record<StatusType, string> = {
    'pass': '#10B981', // green
    'warning': '#F59E0B', // amber
    'error': '#EF4444' // red
  };
  
  const color = statusColors[status] || statusColors.warning;
  
  // Calculate percentage position on the gauge
  const percentage = typeof value === 'number' ? 
    Math.min(Math.max(((value - min) / (max - min)) * 100, 0), 100) : 0;
  const idealPercentage = Math.min(Math.max(((ideal - min) / (max - min)) * 100, 0), 100);
  
  return (
    <div className="parameter-gauge p-4 bg-white rounded-lg border">
      <div className="flex items-center justify-between mb-2">
        <span className="text-sm font-medium text-gray-700">{label}</span>
        <span className="text-xl font-semibold" style={{ color }}>
          {typeof value === 'number' ? value.toFixed(step < 1 ? 1 : 0) : value}{unit}
        </span>
      </div>
      
      <div className="gauge-track h-2 bg-gray-200 rounded-full relative mb-1">
        {/* Ideal marker */}
        <div 
          className="ideal-marker absolute w-1 h-4 bg-gray-500 rounded-full -mt-1" 
          style={{ left: `${idealPercentage}%` }}
          title={`Ideal: ${ideal}${unit}`}
        />
        
        {/* Value indicator */}
        <div 
          className="gauge-fill h-full rounded-full" 
          style={{ 
            width: `${percentage}%`, 
            backgroundColor: color 
          }} 
        />
      </div>
      
      <div className="gauge-labels flex justify-between text-xs text-gray-500">
        <span>{min}{unit}</span>
        <span>{max}{unit}</span>
      </div>
    </div>
  );
}

// Issue card component for displaying validation issues
function IssueCard({ issue, onFix }: IssueCardProps) {
  const [expanded, setExpanded] = useState(false);
  
  return (
    <div className="issue-card border rounded-lg overflow-hidden">
      <div 
        className="issue-header p-4 bg-gray-50 flex items-center justify-between cursor-pointer"
        onClick={() => setExpanded(!expanded)}
      >
        <div className="flex items-center">
          {issue.severity === 'high' ? 
            <AlertOctagon size={18} className="text-red-500 mr-3" /> :
            issue.severity === 'medium' ?
            <AlertTriangle size={18} className="text-yellow-500 mr-3" /> :
            <Info size={18} className="text-blue-500 mr-3" />
          }
          <h4 className="font-medium">{issue.issue}</h4>
        </div>
        <ChevronDown 
          size={18} 
          className={`transition-transform ${expanded ? 'rotate-180' : ''}`}
        />
      </div>
      
      {expanded && (
        <div className="issue-content p-4">
          <p className="text-gray-700 mb-4">{issue.impact}</p>
          
          <div className="recommendation bg-amber-50 p-3 rounded-lg mb-4">
            <div className="flex items-start">
              <Lightbulb size={16} className="text-amber-600 mt-1 mr-2 flex-shrink-0" />
              <div>
                <span className="font-medium text-amber-800">Recommendation:</span>
                <p className="text-amber-700">{issue.suggestion}</p>
              </div>
            </div>
          </div>
          
          {issue.fixable && (
            <Button 
              className="fix-button px-4 py-2 bg-amber-600 text-white rounded hover:bg-amber-700"
              onClick={() => onFix && onFix(issue)}
            >
              Apply Fix
            </Button>
          )}
        </div>
      )}
    </div>
  );
}

// Metric card for displaying summary data
function MetricCard({ label, value, type, icon }: MetricCardProps) {
  const bgColors: Record<MetricType, string> = {
    'critical': 'bg-red-50 border-red-100',
    'warning': 'bg-yellow-50 border-yellow-100',
    'suggestion': 'bg-blue-50 border-blue-100'
  };
  
  const textColors: Record<MetricType, string> = {
    'critical': 'text-red-700',
    'warning': 'text-yellow-700',
    'suggestion': 'text-blue-700'
  };
  
  return (
    <div className={`p-4 rounded-lg border ${bgColors[type] || 'bg-gray-50 border-gray-100'}`}>
      <div className="flex items-center justify-between mb-1">
        <span className="text-sm text-gray-600">{label}</span>
        {icon && <span className={textColors[type]}>{icon}</span>}
      </div>
      <div className={`text-2xl font-semibold ${textColors[type]}`}>
        {value}
      </div>
    </div>
  );
}

