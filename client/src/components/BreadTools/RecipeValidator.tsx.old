                  <Label className="block text-sm font-medium mb-2">Desired outcomes</Label>
                  <div className="space-y-2">
                    <div className="flex items-center space-x-2">
                      <Checkbox 
                        id="light-airy" 
                        checked={context.outcomes.lightAndAiry}
                        onCheckedChange={(checked) => 
                          handleContextChange("outcomes", "lightAndAiry", checked === true)
                        }
                      />
                      <Label htmlFor="light-airy" className="text-sm">Light & airy</Label>
                    </div>
                    <div className="flex items-center space-x-2">
                      <Checkbox 
                        id="dark-crust" 
                        checked={context.outcomes.darkCrust}
                        onCheckedChange={(checked) => 
                          handleContextChange("outcomes", "darkCrust", checked === true)
                        }
                      />
                      <Label htmlFor="dark-crust" className="text-sm">Dark crust</Label>
                    </div>
                    <div className="flex items-center space-x-2">
                      <Checkbox 
                        id="open-crumb" 
                        checked={context.outcomes.openCrumb}
                        onCheckedChange={(checked) => 
                          handleContextChange("outcomes", "openCrumb", checked === true)
                        }
                      />
                      <Label htmlFor="open-crumb" className="text-sm">Open crumb</Label>
                    </div>
                  </div>
                </div>
                
                <div className="mt-6">
                  <h4 className="font-medium text-sm mb-2">Tips for Better Analysis</h4>
                  <ul className="text-sm text-gray-600 space-y-1 list-disc pl-5">
                    <li>Include all ingredients with exact weights</li>
                    <li>Specify times, temperatures, and techniques</li>
                    <li>Mention starter type and feeding schedule if known</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }
  
  // Placeholder for Structured Form
  if (activeScreen === 'input' && selectedMethod === 'structured-form') {
    return (
      <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6 md:p-8">
        <Button 
          variant="ghost" 
          className="mb-4 text-gray-600 hover:text-[#A0522D]"
          onClick={() => setActiveScreen('entry')}
        >
          ← Back to methods
        </Button>
        
        <h2 className="text-2xl font-serif font-bold text-[#4A2A1A] mb-4">Structured Form Input</h2>
        <p className="text-gray-600 mb-6">This input method is being developed. Please try another method.</p>
      </div>
    );
  }
  
  // Placeholder for URL Import
  if (activeScreen === 'input' && selectedMethod === 'import-url') {
    return (
      <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6 md:p-8">
        <Button 
          variant="ghost" 
          className="mb-4 text-gray-600 hover:text-[#A0522D]"
          onClick={() => setActiveScreen('entry')}
        >
          ← Back to methods
        </Button>
        
        <h2 className="text-2xl font-serif font-bold text-[#4A2A1A] mb-4">URL Import</h2>
        <div className="max-w-md mb-6">
          <Input 
            type="url" 
            className="w-full p-3" 
            placeholder="Enter recipe URL"
            value={recipeUrl}
            onChange={(e) => setRecipeUrl(e.target.value)}
          />
          <p className="mt-2 text-sm text-gray-500">Works with most popular baking sites and blogs</p>
          
          <Button 
            className="mt-4 px-6 py-2 text-white bg-[#D97706] hover:bg-[#B45309]"
            disabled={!recipeUrl}
            onClick={handleSubmit}
          >
            Import & Validate
          </Button>
        </div>
      </div>
    );
  }
  
  // Placeholder for Image Upload
  if (activeScreen === 'input' && selectedMethod === 'upload-image') {
    return (
      <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6 md:p-8">
        <Button 
          variant="ghost" 
          className="mb-4 text-gray-600 hover:text-[#A0522D]"
          onClick={() => setActiveScreen('entry')}
        >
          ← Back to methods
        </Button>
        
        <h2 className="text-2xl font-serif font-bold text-[#4A2A1A] mb-4">Image Upload</h2>
        <div className="border-2 border-dashed border-gray-300 rounded-md p-10 text-center max-w-md mb-6">
          <Upload className="mx-auto h-12 w-12 text-gray-400" />
          <p className="mt-4 text-sm text-gray-500">
            Drag and drop a photo of your handwritten recipe, or{" "}
            <button type="button" className="text-[#D97706] hover:text-[#B45309] font-medium">
              browse
            </button>
          </p>
          <p className="mt-2 text-xs text-gray-400">
            Supports JPG, PNG, and PDF files up to 10MB
          </p>
        </div>
      </div>
    );
  }
  
  // Placeholder for Analysis Screen
  if (activeScreen === 'analysis') {
    return (
      <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6 md:p-8">
        <div className="max-w-4xl mx-auto text-center">
          <h2 className="text-2xl font-serif font-bold text-[#4A2A1A] mb-4">Analyzing Recipe</h2>
          <p className="text-gray-600 mb-8">Our system is analyzing your recipe for technical accuracy, consistency, and potential improvements...</p>
          
          <div className="mx-auto w-full max-w-md mb-8">
            <Progress value={65} className="h-2 bg-gray-200" />
          </div>
          
          <div className="space-y-4 mb-10">
            <div className="flex items-center text-gray-600">
              <Check className="text-green-500 mr-2" size={18} />
              <span>Ingredient detection complete</span>
            </div>
            <div className="flex items-center text-gray-600">
              <Check className="text-green-500 mr-2" size={18} />
              <span>Formula validation complete</span>
            </div>
            <div className="flex items-center text-gray-600">
              <AlertCircle className="text-amber-600 mr-2" size={18} />
              <span>Analyzing process techniques...</span>
            </div>
            <div className="flex items-center text-gray-600">
              <div className="h-[18px] w-[18px] mr-2" />
              <span className="text-gray-400">Generating recommendations...</span>
            </div>
          </div>
        </div>
      </div>
    );
  }
  
  // Render the Results Screen
  if (activeScreen === 'results') {
    return (
      <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6 md:p-8">
        <div className="max-w-5xl mx-auto">
          <Button 
            variant="ghost" 
            className="mb-4 text-gray-600 hover:text-[#A0522D]"
            onClick={() => setActiveScreen('input')}
          >
            ← Back to editor
          </Button>
          
          <h2 className="text-2xl font-serif font-bold text-[#4A2A1A] mb-6">Recipe Analysis Results</h2>
          
          {/* Results Overview Section */}
          <div className="validation-summary p-6 rounded-lg shadow-sm border mb-8">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-xl font-semibold text-gray-900">Recipe Analysis</h3>
              <div className={`status-badge px-3 py-1 rounded-full text-sm font-medium 
                ${sampleValidationResults.summary.overallStatus === 'good' ? 'bg-green-100 text-green-800 border-green-200' : 
                sampleValidationResults.summary.overallStatus === 'needs-attention' ? 'bg-yellow-100 text-yellow-800 border-yellow-200' :
                'bg-red-100 text-red-800 border-red-200'}`}>
                {sampleValidationResults.summary.overallStatus === 'good' ? 'Recipe Looks Good!' : 
                 sampleValidationResults.summary.overallStatus === 'needs-attention' ? 'Recipe Needs Attention' :
                 'Recipe Needs Correction'}
              </div>
            </div>
            
            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <MetricCard 
                label="Technical Issues" 
                value={sampleValidationResults.summary.critical} 
                type="critical"
                icon={<AlertOctagon size={18} />} 
              />
              <MetricCard 
                label="Warnings" 
                value={sampleValidationResults.summary.warnings} 
                type="warning"
                icon={<AlertTriangle size={18} />} 
              />
              <MetricCard 
                label="Suggestions" 
                value={sampleValidationResults.summary.suggestions} 
                type="suggestion"
                icon={<Info size={18} />} 
              />
            </div>
            
            <div className="key-parameters grid grid-cols-1 md:grid-cols-2 gap-4">
              <ParameterGauge 
                label="Hydration" 
                value={sampleValidationResults.technicalAccuracy.hydrationLevel.value} 
                status={sampleValidationResults.technicalAccuracy.hydrationLevel.status as StatusType} 
                ideal={sampleValidationResults.technicalAccuracy.hydrationLevel.idealValue} 
                min={65} 
                max={90} 
              />
              <ParameterGauge 
                label="Salt %" 
                value={sampleValidationResults.technicalAccuracy.saltPercentage.value} 
                status={sampleValidationResults.technicalAccuracy.saltPercentage.status as StatusType} 
                ideal={sampleValidationResults.technicalAccuracy.saltPercentage.idealValue} 
                min={1.5} 
                max={2.5} 
                step={0.1} 
              />
              <ParameterGauge 
                label="Starter %" 
                value={sampleValidationResults.technicalAccuracy.starterPercentage.value} 
                status={sampleValidationResults.technicalAccuracy.starterPercentage.status as StatusType} 
                ideal={sampleValidationResults.technicalAccuracy.starterPercentage.idealValue} 
                min={5} 
                max={35} 
              />
              <ParameterGauge 
                label="Bulk Fermentation" 
                value={sampleValidationResults.processValidity.fermentationTime.value / 60} // Convert to hours
                status={sampleValidationResults.processValidity.fermentationTime.status as StatusType} 
                ideal={sampleValidationResults.processValidity.fermentationTime.idealValue / 60} 
                min={2} 
                max={8}
                unit="h" 
              />
            </div>
          </div>
          
          {/* Issues & Recommendations Section */}
          <div className="issues-container p-6 bg-white rounded-lg shadow-sm border mb-8">
            <h3 className="text-xl font-semibold text-gray-900 mb-4">Issues & Recommendations</h3>
            
            {sampleValidationResults.issues.length === 0 ? (
              <div className="empty-state p-6 bg-green-50 rounded-lg text-center">
                <CheckCircle size={32} className="text-green-500 mx-auto mb-3" />
                <p className="text-green-800 font-medium">No issues found!</p>
                <p className="text-green-600">Your recipe looks technically sound.</p>
              </div>
            ) : (
              <div className="space-y-6">
                {/* High severity issues */}
                {sampleValidationResults.issues.filter(issue => issue.severity === 'high').length > 0 && (
                  <div>
                    <h4 className="text-lg font-medium mb-3 flex items-center">
                      <AlertOctagon size={18} className="text-red-500 mr-2" />
                      <span>Critical Issues</span>
                      <span className="ml-2 text-sm text-gray-500">
                        ({sampleValidationResults.issues.filter(issue => issue.severity === 'high').length})
                      </span>
                    </h4>
                    
                    <div className="space-y-4">
                      {sampleValidationResults.issues
                        .filter(issue => issue.severity === 'high')
                        .map((issue, index) => (
                          <IssueCard 
                            key={`high-${index}`} 
                            issue={issue} 
                            onFix={handleApplyFix} 
                          />
                        ))
                      }
                    </div>
                  </div>
                )}
                
                {/* Medium severity issues */}
                {sampleValidationResults.issues.filter(issue => issue.severity === 'medium').length > 0 && (
                  <div>
                    <h4 className="text-lg font-medium mb-3 flex items-center">
                      <AlertTriangle size={18} className="text-yellow-500 mr-2" />
                      <span>Warnings</span>
                      <span className="ml-2 text-sm text-gray-500">
                        ({sampleValidationResults.issues.filter(issue => issue.severity === 'medium').length})
                      </span>
                    </h4>
                    
                    <div className="space-y-4">
                      {sampleValidationResults.issues
                        .filter(issue => issue.severity === 'medium')
                        .map((issue, index) => (
                          <IssueCard 
                            key={`medium-${index}`} 
                            issue={issue} 
                            onFix={handleApplyFix} 
                          />
                        ))
                      }
                    </div>
                  </div>
                )}
                
                {/* Low severity issues */}
                {sampleValidationResults.issues.filter(issue => issue.severity === 'low').length > 0 && (
                  <div>
                    <h4 className="text-lg font-medium mb-3 flex items-center">
                      <Info size={18} className="text-blue-500 mr-2" />
                      <span>Suggestions</span>
                      <span className="ml-2 text-sm text-gray-500">
                        ({sampleValidationResults.issues.filter(issue => issue.severity === 'low').length})
                      </span>
                    </h4>
                    
                    <div className="space-y-4">
                      {sampleValidationResults.issues
                        .filter(issue => issue.severity === 'low')
                        .map((issue, index) => (
                          <IssueCard 
                            key={`low-${index}`} 
                            issue={issue} 
                            onFix={handleApplyFix} 
                          />
                        ))
                      }
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
          
          {/* Optimized Recipe Section */}
          <div className="recipe-comparison p-6 bg-white rounded-lg shadow-sm border mb-6">
            <h3 className="text-xl font-semibold text-gray-900 mb-4">Optimized Recipe</h3>
            
            <div className="bg-gray-50 p-4 rounded-lg mb-6">
              <h4 className="font-medium mb-2">Optimization Summary</h4>
              <ul className="space-y-2 text-sm">
                <li className="flex items-center">
                  <span className="text-green-600">
                    <ArrowUpRight size={16} className="inline mr-1" />
                    Hydration adjusted to {sampleValidationResults.optimizedRecipe.hydration}%
                  </span>
                </li>
                <li className="flex items-center">
                  <span className="text-green-600">
                    <ArrowUpRight size={16} className="inline mr-1" />
                    Salt increased to 2% for better flavor development  
                  </span>
                </li>
                <li className="flex items-center">
                  <span className="text-blue-600">
                    <Lightbulb size={16} className="inline mr-1" />
                    Added stretch and fold technique during bulk fermentation
                  </span>
                </li>
              </ul>
            </div>
            
            <div className="optimized-recipe">
              <h4 className="font-medium mb-3">Ingredients</h4>
              <ul className="list-disc list-inside mb-6 space-y-1">
                {sampleValidationResults.optimizedRecipe.ingredients.map((ingredient, idx) => (
                  <li key={idx} className="text-gray-700">
                    {ingredient.amount}{ingredient.unit} {ingredient.name} 
                    <span className="text-gray-500 text-sm ml-2">({ingredient.percentage}%)</span>
                  </li>
                ))}
              </ul>
              
              <h4 className="font-medium mb-3">Method</h4>
              <ol className="space-y-3 mb-6">
                {sampleValidationResults.optimizedRecipe.process.map((step, idx) => (
                  <li key={idx} className="pl-6 relative">
                    <span className="absolute left-0 font-medium">{step.step}.</span>
                    <span className="font-medium">{step.name}:</span> {step.details}
                  </li>
                ))}
              </ol>
            </div>
            
            <div className="flex justify-between mt-6">
              <Button 
                variant="outline" 
                className="text-[#A0522D] border-[#A0522D] hover:bg-[#F8F3E9]"
                onClick={() => setActiveScreen('entry')}
              >
                Start Over
              </Button>
              
              <div className="space-x-4">
                <Button 
                  variant="outline"
                  className="text-[#A0522D] border-[#A0522D] hover:bg-[#F8F3E9]"
                  onClick={handleApplyAllOptimizations}
                >
                  Apply All Optimizations
                </Button>
                
                <Button 
                  className="text-white bg-[#D97706] hover:bg-[#B45309]"
                >
                  Save Recipe
                </Button>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }
  
  // Fallback to entry screen
  return (
    <div className="bg-white rounded-lg shadow-sm overflow-hidden p-6">
      <p className="text-center text-gray-600">Loading validator...</p>
    </div>
  );
}