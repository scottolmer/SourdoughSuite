# Example environment configuration for Bakehouse Breads mobile app
# Copy this file to .env for local development

# API Configuration
API_URL=http://localhost:5000

# Stripe Configuration (Public key only - secret key stays on server)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Logging
LOG_LEVEL=info