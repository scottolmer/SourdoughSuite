  }
  
  // FAQ methods
  async getAllFaqs(): Promise<FAQ[]> {
    return await db.select().from(faqs);
  }
  
  async getFaqById(id: number): Promise<FAQ | undefined> {
    const [faq] = await db.select().from(faqs).where(eq(faqs.id, id));
    return faq || undefined;
  }
  
  async getFaqsByCategory(category: string): Promise<FAQ[]> {
    return await db.select().from(faqs).where(eq(faqs.category, category));
  }
  
  async getPublishedFaqs(): Promise<FAQ[]> {
    return await db.select().from(faqs).where(eq(faqs.isPublished, true));
  }
  
  async createFaq(insertFaq: InsertFAQ): Promise<FAQ> {
    const now = new Date();
    
    const [faq] = await db
      .insert(faqs)
      .values({
        ...insertFaq,
        createdAt: now,
        updatedAt: now
      } as any)
      .returning();
    return faq;
  }
  
  async updateFaq(id: number, faqUpdates: Partial<InsertFAQ>): Promise<FAQ | undefined> {
    const now = new Date();
    
    const [updatedFaq] = await db
      .update(faqs)
      .set({
        ...faqUpdates,
        updatedAt: now
      } as any)
      .where(eq(faqs.id, id))
      .returning();
    return updatedFaq || undefined;
  }
  
  async deleteFaq(id: number): Promise<boolean> {
    const result = await db
      .delete(faqs)
      .where(eq(faqs.id, id))
      .returning({ id: faqs.id });
    return result.length > 0;
  }
  
  // Blog post methods
  async getAllBlogPosts(): Promise<BlogPost[]> {
    return await db.select().from(blogPosts).orderBy(blogPosts.createdAt);
  }
  
  async getPublishedBlogPosts(): Promise<BlogPost[]> {
    return await db.select().from(blogPosts)
      .where(eq(blogPosts.isPublished, true))
      .orderBy(blogPosts.publishedAt);
  }
  
  async getBlogPostById(id: number): Promise<BlogPost | undefined> {
    const [post] = await db.select().from(blogPosts).where(eq(blogPosts.id, id));
    return post || undefined;
  }
  
  async getBlogPostBySlug(slug: string): Promise<BlogPost | undefined> {
    const [post] = await db.select().from(blogPosts).where(eq(blogPosts.slug, slug));
    return post || undefined;
  }
  
  async getBlogPostsByCategory(category: string): Promise<BlogPost[]> {
    return await db.select().from(blogPosts)
      .where(and(
        eq(blogPosts.category, category),
        eq(blogPosts.isPublished, true)
      ))
      .orderBy(blogPosts.publishedAt);
  }
  
  async getBlogPostsByAuthor(authorId: number): Promise<BlogPost[]> {
    return await db.select().from(blogPosts)
      .where(eq(blogPosts.authorId, authorId))
      .orderBy(blogPosts.createdAt);
  }
  
  async createBlogPost(insertBlogPost: InsertBlogPost): Promise<BlogPost> {
    const now = new Date();
    
    // Set publishedAt if the post is published
    let publishedAt = insertBlogPost.publishedAt;
    if (insertBlogPost.isPublished && !publishedAt) {
      publishedAt = now;
    }
    
    const [post] = await db
      .insert(blogPosts)
      .values({
        ...insertBlogPost,
        publishedAt,
        createdAt: now,
        updatedAt: now
      } as any)
      .returning();
    return post;
  }
  
  async updateBlogPost(id: number, blogPostUpdates: UpdateBlogPost): Promise<BlogPost | undefined> {
    const now = new Date();
    
    // If post is being published and doesn't have a publishedAt date, set it
    let updates = { ...blogPostUpdates, updatedAt: now } as any;
    
    if (blogPostUpdates.isPublished === true) {
      // Check if the post already has a publishedAt date
      const existingPost = await this.getBlogPostById(id);
      if (existingPost && !existingPost.publishedAt) {
        updates.publishedAt = now;
      }
    }
    
    const [updatedPost] = await db
      .update(blogPosts)
      .set(updates)
      .where(eq(blogPosts.id, id))
      .returning();
    return updatedPost || undefined;
  }
  
  async deleteBlogPost(id: number): Promise<boolean> {
    const result = await db
      .delete(blogPosts)
      .where(eq(blogPosts.id, id))
      .returning({ id: blogPosts.id });
    return result.length > 0;
  }
  
  // Starter feeding logs methods
  async getUserFeedingLogs(userId: number): Promise<StarterFeedingLog[]> {
    return await db
      .select()
      .from(starterFeedingLogs)
      .where(eq(starterFeedingLogs.userId, userId))
      .orderBy(desc(starterFeedingLogs.feedingDate));
  }
  
  async getStarterFeedingLogs(starterId: number): Promise<StarterFeedingLog[]> {
    return await db
      .select()
      .from(starterFeedingLogs)
      .where(eq(starterFeedingLogs.starterId, starterId))
      .orderBy(desc(starterFeedingLogs.feedingDate));
  }
  
  async getStarterFeedingLogsByDate(starterId: number, date: Date): Promise<StarterFeedingLog[]> {
    // Create start date for the selected day (midnight)
    const startOfDay = new Date(date);
    startOfDay.setHours(0, 0, 0, 0);
    
    // Convert to ISO string format for date comparison (YYYY-MM-DD)
    const dateString = startOfDay.toISOString().split('T')[0];
    
    // Get all logs for this starter
    const logs = await db
      .select()
      .from(starterFeedingLogs)
      .where(eq(starterFeedingLogs.starterId, starterId))
      .orderBy(desc(starterFeedingLogs.feedingDate));
      
    // Filter logs by date manually (comparing just the date part)
    return logs.filter(log => {
      const logDate = new Date(log.feedingDate);
      const logDateString = logDate.toISOString().split('T')[0];
      return logDateString === dateString;
    });
  }
  
  async getStarterFeedingLogDates(starterId: number): Promise<Date[]> {
    const logs = await db
      .select({ feedingDate: starterFeedingLogs.feedingDate })
      .from(starterFeedingLogs)
      .where(eq(starterFeedingLogs.starterId, starterId))
      .orderBy(desc(starterFeedingLogs.feedingDate));
    
    // Extract unique dates (just the day part, not the time)
    const uniqueDates = new Map<string, Date>();
    
    logs.forEach(log => {
      const date = new Date(log.feedingDate);
      const dateKey = date.toISOString().split('T')[0]; // Just the YYYY-MM-DD part
      if (!uniqueDates.has(dateKey)) {
        uniqueDates.set(dateKey, date);
      }
    });
    
    return Array.from(uniqueDates.values());
  }
  
  async createFeedingLog(log: InsertStarterFeedingLog): Promise<StarterFeedingLog> {
    // Make sure the date is properly handled
    let feedingDateValue = log.feedingDate;
    
    // If it's a string, convert it to a Date object
    if (typeof feedingDateValue === 'string') {
      feedingDateValue = new Date(feedingDateValue);
    }
    
    // Create a new object with the proper date format
    const formattedLog = {
      ...log,
      feedingDate: feedingDateValue
    };
    
    // Insert the log with proper date format
    const [feedingLog] = await db
      .insert(starterFeedingLogs)
      .values(formattedLog)
      .returning();
      
    return feedingLog;
  }
  
  async deleteFeedingLog(id: number): Promise<boolean> {
    const result = await db
      .delete(starterFeedingLogs)
      .where(eq(starterFeedingLogs.id, id))
      .returning({ id: starterFeedingLogs.id });
    return result.length > 0;
  }
  
  // Starter health logs methods
  async getUserHealthLogs(userId: number): Promise<StarterHealthLog[]> {
    return await db.select().from(starterHealthLogs).where(eq(starterHealthLogs.userId, userId)).orderBy(desc(starterHealthLogs.logDate));
  }
  
  async getStarterHealthLogs(starterId: number): Promise<StarterHealthLog[]> {
    return await db.select().from(starterHealthLogs).where(eq(starterHealthLogs.starterId, starterId)).orderBy(desc(starterHealthLogs.logDate));
  }
  
  async getHealthLogById(id: number): Promise<StarterHealthLog | undefined> {
    const [log] = await db.select().from(starterHealthLogs).where(eq(starterHealthLogs.id, id));
    return log || undefined;
  }
  
  async getLatestHealthLog(starterId: number): Promise<StarterHealthLog | undefined> {
    const [log] = await db
      .select()
      .from(starterHealthLogs)
      .where(eq(starterHealthLogs.starterId, starterId))
      .orderBy(desc(starterHealthLogs.logDate))
      .limit(1);
    return log || undefined;
  }
  
  async createHealthLog(insertHealthLog: InsertStarterHealthLog): Promise<StarterHealthLog> {
    const now = new Date();
    
    // Extract fields from input while converting date formats properly
    const {
      userId,
      starterId,
      activityRating,
      riseHeight,
      smell,
      appearance,
      temperature,
      photoUrl,
      notes,
      consistency
    } = insertHealthLog;
    
    // Convert dateTime fields to proper format or use current date
    const logDate = insertHealthLog.logDate 
      ? (typeof insertHealthLog.logDate === 'string' 
          ? new Date(insertHealthLog.logDate) 
          : insertHealthLog.logDate)
      : now;
      
    const lastFedTimestamp = insertHealthLog.lastFedTimestamp
      ? (typeof insertHealthLog.lastFedTimestamp === 'string'
          ? new Date(insertHealthLog.lastFedTimestamp)
          : insertHealthLog.lastFedTimestamp)
      : undefined;
    
    // Insert with properly formatted date objects
    const [healthLog] = await db
      .insert(starterHealthLogs)
      .values({
        userId,
        starterId,
        logDate,
        activityRating,
        riseHeight,
        smell,
        appearance,
        temperature,
        lastFedTimestamp,
        photoUrl,
        notes,
        consistency,
        createdAt: now
      })
      .returning();
      
    return healthLog;
  }
  
  async updateHealthLog(id: number, healthLogUpdates: Partial<InsertStarterHealthLog>): Promise<StarterHealthLog | undefined> {
    // Create a new object for updates
    const updates: Record<string, any> = {};
    
    // Copy all primitive fields directly
    Object.keys(healthLogUpdates).forEach(key => {
      const value = healthLogUpdates[key as keyof typeof healthLogUpdates];
      
      // Handle Date objects specifically
      if (key === 'logDate' && value) {
        updates[key] = typeof value === 'string' ? new Date(value) : value;
      } 
      else if (key === 'lastFedTimestamp' && value) {
        updates[key] = typeof value === 'string' ? new Date(value) : value;
      }
      // Copy all other fields directly
      else if (key !== 'logDate' && key !== 'lastFedTimestamp') {
        updates[key] = value;
      }
    });
    
    const [updatedHealthLog] = await db
      .update(starterHealthLogs)
      .set(updates)
      .where(eq(starterHealthLogs.id, id))
      .returning();
      
    return updatedHealthLog || undefined;
  }
  
  async deleteHealthLog(id: number): Promise<boolean> {
    const result = await db
      .delete(starterHealthLogs)
      .where(eq(starterHealthLogs.id, id))
      .returning({ id: starterHealthLogs.id });
    return result.length > 0;
  }
}

