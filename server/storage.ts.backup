  async updateStarter(id: number, starterUpdates: Partial<InsertSourdoughStarter>): Promise<SourdoughStarter | undefined> {
    const now = new Date().toISOString();
    
    const [updatedStarter] = await db
      .update(sourdoughStarters)
      .set({
        ...starterUpdates,
        updatedAt: now
      } as any)
